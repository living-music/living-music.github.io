    { "name": "Search", "short_name": "Search", "description": "Search the music catalog", "url": "/#/search", "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Favorites", "short_name": "Favorites", "description": "Open favorite songs", "url": "/#/library/favorites", "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Playlists", "short_name": "Playlists", "description": "Open playlists", "url": "/#/playlists", "icons": [{ "src": "/app-icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
